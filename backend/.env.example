# =============================================
# Backend 환경변수 설정 가이드
# 이 파일을 복사해서 backend/.env 로 이름을 바꾼 뒤 값을 채워주세요.
# cp backend/.env.example backend/.env
# =============================================

# [필수] MongoDB 연결 주소
# Docker Compose 사용 시: mongodb://xtock-mongodb:27017
# 로컬 직접 실행 시: mongodb://localhost:27017
MONGODB_URI=mongodb://xtock-mongodb:27017

# [필수] MongoDB 데이터베이스 이름
MONGODB_NAME=xtock_xignal
