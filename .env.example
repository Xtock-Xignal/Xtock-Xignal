# =============================================
# Xtock-Xignal 환경변수 설정 가이드
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채워주세요.
# cp .env.example .env
# =============================================

# [필수] Google Gemini API Key
# 뉴스 요약, 금융 용어 검색(AI 분석), 번역 기능에 사용됩니다.
# 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# [선택] Finnhub API Key
# 없으면 Yahoo Finance RSS 뉴스만 수집합니다 (뉴스 기능은 동작).
# 발급: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# [선택] 프론트엔드 → 백엔드 API 주소
# 로컬 실행 시 기본값(http://localhost:8000)이 자동 적용되므로 생략 가능.
# 배포 환경에서는 실제 백엔드 서버 주소로 변경해주세요.
NEXT_PUBLIC_API_URL=http://localhost:8000
